ui_port: 18082
allowed_contexts: [internal]
bastion:
  ssh_host: gigacode-bastion
  socks_proxy: socks5h://127.0.0.1:11080
datasets_root: ../.fleet-console/datasets
s3_read_profile: gcvmfleet_ro
s3_write_profile: gcvmfleet
auth:
  mode: local
results:
  private_s3_root: ""
  allow_shared_bucket: false  # При включённом входе разрешить путь Fleet, если закрытый путь пуст.
