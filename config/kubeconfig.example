# Основа для выданного kubeconfig. Сохраните его настройки TLS и аутентификации.
apiVersion: v1
kind: Config
clusters:
  - name: internalCluster
    cluster:
      server: https://127.0.0.1:18443
      certificate-authority: kube-ca.crt
contexts:
  - name: internal
    context:
      cluster: internalCluster
      user: console
current-context: internal
users:
  - name: console
    user:
      token: REPLACE_WITH_TOKEN
